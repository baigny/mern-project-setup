<%- include("partials/header") %>

<h1>Register</h1>

<% if (errors.length) { %>
  <ul class="errors">
    <% errors.forEach((e) => { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<form method="POST" action="/register">
  <p><label>Username<br><input type="text" name="username" value="<%= values.username || '' %>" /></label></p>
  <p><label>Email<br><input type="email" name="email" value="<%= values.email || '' %>" /></label></p>
  <p><label>Password<br><input type="password" name="password" /></label></p>
  <button type="submit">Create account</button>
</form>

<p>Already have an account? <a href="/login">Log in</a></p>

<%- include("partials/footer") %>
